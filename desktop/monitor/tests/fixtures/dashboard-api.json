{
 "dashboard": {
  "uid": "reelshelf-api",
  "title": "Reelshelf API",
  "tags": [
   "reelshelf"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
   "from": "now-6h",
   "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
   "list": []
  },
  "description": ".NET's own meters from the clips API (reelshelf's QueueMetricsSetup.PlatformMeters), pushed over OTLP.",
  "templating": {
   "list": [
    {
     "name": "env",
     "label": "Environment",
     "type": "query",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "query": {
      "query": "label_values(http_server_request_duration_seconds_count, deployment_environment_name)",
      "refId": "env"
     },
     "definition": "label_values(http_server_request_duration_seconds_count, deployment_environment_name)",
     "refresh": 2,
     "includeAll": true,
     "multi": false,
     "current": {
      "selected": true,
      "text": "Production",
      "value": "Production"
     },
     "allValue": ".*"
    }
   ]
  },
  "panels": [
   {
    "type": "row",
    "title": "Requests",
    "id": 1,
    "collapsed": false,
    "gridPos": {
     "h": 1,
     "w": 24,
     "x": 0,
     "y": 0
    },
    "panels": []
   },
   {
    "type": "stat",
    "title": "Requests per second",
    "id": 2,
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "gridPos": {
     "h": 4,
     "w": 6,
     "x": 0,
     "y": 1
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "sum(rate(http_server_request_duration_seconds_count{http_route!=\"/health\",deployment_environment_name=~\"$env\"}[5m]))",
      "instant": true
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "reqps",
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "text",
         "value": null
        }
       ]
      },
      "color": {
       "mode": "thresholds"
      }
     },
     "overrides": []
    },
    "options": {
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ],
      "fields": "",
      "values": false
     },
     "colorMode": "value",
     "graphMode": "area",
     "textMode": "auto",
     "justifyMode": "auto"
    }
   },
   {
    "type": "stat",
    "title": "5xx, last 5 min",
    "id": 3,
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "gridPos": {
     "h": 4,
     "w": 6,
     "x": 6,
     "y": 1
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "(sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\",http_route!=\"/health\",deployment_environment_name=~\"$env\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{http_route!=\"/health\",deployment_environment_name=~\"$env\"}[5m]))",
      "instant": true
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "percentunit",
      "decimals": 2,
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "orange",
         "value": 0.01
        },
        {
         "color": "red",
         "value": 0.05
        }
       ]
      },
      "color": {
       "mode": "thresholds"
      }
     },
     "overrides": []
    },
    "options": {
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ],
      "fields": "",
      "values": false
     },
     "colorMode": "value",
     "graphMode": "area",
     "textMode": "auto",
     "justifyMode": "auto"
    }
   },
   {
    "type": "stat",
    "title": "p95 latency, last 5 min",
    "id": 4,
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "gridPos": {
     "h": 4,
     "w": 6,
     "x": 12,
     "y": 1
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health|/api/activity/hub.*\",deployment_environment_name=~\"$env\"}[5m])))",
      "instant": true
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "s",
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "orange",
         "value": 1
        },
        {
         "color": "red",
         "value": 2
        }
       ]
      },
      "color": {
       "mode": "thresholds"
      }
     },
     "overrides": []
    },
    "options": {
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ],
      "fields": "",
      "values": false
     },
     "colorMode": "value",
     "graphMode": "area",
     "textMode": "auto",
     "justifyMode": "auto"
    }
   },
   {
    "type": "stat",
    "title": "Rate-limited, last hour",
    "id": 5,
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "gridPos": {
     "h": 4,
     "w": 6,
     "x": 18,
     "y": 1
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "sum(increase(aspnetcore_rate_limiting_requests_total{aspnetcore_rate_limiting_result!=\"acquired\",deployment_environment_name=~\"$env\"}[1h])) or vector(0)",
      "instant": true
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "short",
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "text",
         "value": null
        }
       ]
      },
      "color": {
       "mode": "thresholds"
      }
     },
     "overrides": []
    },
    "options": {
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ],
      "fields": "",
      "values": false
     },
     "colorMode": "value",
     "graphMode": "area",
     "textMode": "auto",
     "justifyMode": "auto"
    }
   },
   {
    "type": "timeseries",
    "title": "Requests by status",
    "id": 6,
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "gridPos": {
     "h": 8,
     "w": 12,
     "x": 0,
     "y": 5
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "sum by (status) (label_replace(rate(http_server_request_duration_seconds_count{http_route!=\"/health\",deployment_environment_name=~\"$env\"}[$__rate_interval]), \"status\", \"${1}xx\", \"http_response_status_code\", \"(.).*\"))",
      "legendFormat": "{{status}}"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "reqps",
      "custom": {
       "drawStyle": "line",
       "lineWidth": 2,
       "fillOpacity": 15,
       "stacking": {
        "mode": "normal",
        "group": "A"
       },
       "showPoints": "never",
       "spanNulls": true,
       "lineInterpolation": "linear"
      },
      "min": 0
     },
     "overrides": []
    },
    "options": {
     "legend": {
      "displayMode": "list",
      "placement": "bottom",
      "showLegend": true
     },
     "tooltip": {
      "mode": "multi",
      "sort": "desc"
     }
    }
   },
   {
    "type": "timeseries",
    "title": "Latency",
    "id": 7,
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "gridPos": {
     "h": 8,
     "w": 12,
     "x": 12,
     "y": 5
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health|/api/activity/hub.*\",deployment_environment_name=~\"$env\"}[$__rate_interval])))",
      "legendFormat": "p50"
     },
     {
      "refId": "B",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health|/api/activity/hub.*\",deployment_environment_name=~\"$env\"}[$__rate_interval])))",
      "legendFormat": "p95"
     },
     {
      "refId": "C",
      "datasource": {
       "type": "prometheus",
       "uid": "prometheus"
      },
      "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health|/api/activity/hub.*\",deployment_environment_name=~\"$env\"}[$__rate_interval])))",
      "legendFormat": "p99"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "s",
      "custom": {
       "drawStyle": "line",
       "lineWidth": 2,
       "fillOpacity": 5,
       "stacking": {
        "mode": "none",
        "group": "A"
       },
       "showPoints": "never",
       "spanNulls": true,
       "lineInterpolation": "linear"
      },
      "min": 0
     },
     "overrides": []
    },
    "options": {
     "legend": {
      "displayMode": "list",
      "placement": "bottom",
      "showLegend": true
     },
     "tooltip": {
      "mode": "multi",
      "sort": "desc"
     }
    }
   },
   {
    "type": "timeseries",
