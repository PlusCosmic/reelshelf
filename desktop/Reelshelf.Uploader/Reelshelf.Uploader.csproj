<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Reelshelf Uploader for Windows: an Avalonia tray app over Reelshelf.Uploader.Core, with the Windows-only parts
      (Credential Manager, the full-screen game check, toasts, the MSIX startup task). Built by desktop/Reelshelf.Uploader.sln
      on the Windows CI job, never by Reelshelf.sln; EnableWindowsTargeting lets it compile on Linux too, though it only runs
      on Windows 10 1809+ and 11, x64, packaged as an MSIX (desktop/Reelshelf.Uploader.Package).
    -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\Icons\reelshelf.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AssemblyName>Reelshelf.Uploader</AssemblyName>
        <RootNamespace>Reelshelf.Uploader</RootNamespace>
        <!-- Set from the uploader-v<major>.<minor>.<patch> tag by publish-uploader.yml. -->
        <Version Condition="'$(Version)' == ''">0.1.0</Version>
        <Product>Reelshelf Uploader</Product>
        <Company>Reelshelf</Company>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Reelshelf.Uploader.Test" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.22" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Reelshelf.Uploader.Core\Reelshelf.Uploader.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

</Project>
