<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>reelshelf-secrets</UserSecretsId>
        <LangVersion>13</LangVersion>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

        <!-- OpenAPI Generation Configuration -->
        <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Reelshelf.Test" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
        <PackageReference Include="Dapper" Version="2.1.89" />
        <PackageReference Include="FFMpegCore" Version="5.5.0" />
        <PackageReference Include="IGDB" Version="6.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="OpenAI" Version="2.14.0" />
        <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="ApexLegends\tmpclaude-2019-cwd" />
    </ItemGroup>

    <ItemGroup>
        <!-- Embedded instead of published: the Web SDK would otherwise copy the schema .json to the publish output. -->
        <Content Remove="ApexLegends/LegendDetection/Resources/**" />
        <EmbeddedResource Include="ApexLegends/LegendDetection/Resources/prompt.md" LogicalName="LegendDetection.prompt.md" />
        <EmbeddedResource Include="ApexLegends/LegendDetection/Resources/response-schema.json" LogicalName="LegendDetection.response-schema.json" />
        <EmbeddedResource Include="ApexLegends/LegendDetection/Resources/reference-sheet.png" LogicalName="LegendDetection.reference-sheet.png" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="Shared/whitelist.json">
            <Link>whitelist.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>
